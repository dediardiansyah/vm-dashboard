// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 Int      @id @default(autoincrement())
  userId             Int
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            Int       @id @default(autoincrement())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  role          String?
  status        String?
  password      String?

  accounts      Account[]
  sessions      Session[]
  scores        Score[]
  members       Members[]
  redeems      Redeem[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Campaign {
  id Int @id @default(autoincrement())
  name String
  description String?
  subdomain String @unique
  about String?
  howToPlay String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Banner Banner[]
  Gallery Gallery[]
  Score Score[]
  Voucher Voucher[]
  Redeem Redeem[]
  rewards Reward[]
}

model Banner {
  id Int @id @default(autoincrement())
  campaignId Int
  imageUrl String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model Gallery {
  id Int @id @default(autoincrement())
  campaignId Int
  imageUrl String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model Score {
  id Int @id @default(autoincrement())
  campaignId Int
  userId Int
  score Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
  user User @relation(fields: [userId], references: [id])
}

model Members {
  id Int @id @default(autoincrement())
  userId Int
  phone String
  instagram String?
  lastActiveAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  

  user User @relation(fields: [userId], references: [id])
}

model Voucher {
  id Int @id @default(autoincrement())
  campaignId Int  
  code String @unique
  maxUses     Int      @default(1)
  usedCount   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
  redeems Redeem[]
}

model Redeem {
  id Int @id @default(autoincrement())
  campaignId Int
  userId Int
  voucherId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
  user User @relation(fields: [userId], references: [id])
  voucher Voucher @relation(fields: [voucherId], references: [id])
}

model CopyText {
  id Int @id @default(autoincrement())
  type String
  content String @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type])
}

model Transaction {
  id                Int       @id @default(autoincrement())
  transactionId     String    @unique // For Midtrans order ID
  machineId         Int
  parfumeId         Int
  amount            Int
  paymentMethod     String    // QRIS, VIRTUAL_ACCOUNT, etc
  paymentStatus     String    // PENDING, SUCCESS, FAILED, EXPIRED
  paymentDetails    Json?     // Store Midtrans response
  paymentSource     String?   // Payment source (e.g., DANA, OVO, etc)
  vaNumber         String?   // Virtual Account number if applicable
  qrCode           String?   // QR Code URL if using QRIS
  deepLinkUrl      String?   // Mobile payment deeplink URL
  expiryTime       DateTime? // Payment expiry time
  paidAt           DateTime? // When payment was completed
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  machine          Machine    @relation(fields: [machineId], references: [id])
  parfume         Parfume    @relation(fields: [parfumeId], references: [id])
}

model Machine {
  id Int @id @default(autoincrement())
  name String
  status String
  location String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machineParfumes MachineParfume[]
  transactions Transaction[]
}

model Parfume {
  id Int @id @default(autoincrement())
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machineParfumes MachineParfume[]
  transactions Transaction[]
}

model MachineParfume {
  id Int @id @default(autoincrement())
  machineId Int
  parfumeId Int
  sprayCount Int @default(50)
  sprayLimit Int @default(50)
  lastRefillAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  machine Machine @relation(fields: [machineId], references: [id])
  parfume Parfume @relation(fields: [parfumeId], references: [id])
}

model Reward {
  id          Int      @id @default(autoincrement())
  campaignId  Int
  name        String
  points      Int
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign    Campaign @relation(fields: [campaignId], references: [id])
}