"use client"

import { useState, useEffect } from "react"
import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog"
import { Input } from "@/components/ui/input"
import { Button } from "@/components/ui/button"
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select"
import { Label } from "@/components/ui/label"
import { Alert, AlertDescription } from "@/components/ui/alert"
import { AlertCircle } from "lucide-react"
import { update{{pascalCase (singular name)}}Schema, type IUpdate{{pascalCase (singular name)}} } from "@/schemas/{{singular name}}Schema"
import { validateForm } from "@/lib/utils/validate-form"

interface Edit{{pascalCase (singular name)}}DialogProps {
  {{singular name}}: {
    id: number
    {{#each (parseFields fields)}}
    {{name}}: {{#if (eq type "number")}}number{{else if (eq type "boolean")}}boolean{{else}}string{{/if}}
    {{/each}}
  } | null
  open: boolean
  onOpenChange: (open: boolean) => void
  onSubmit: (id: number, data: IUpdate{{pascalCase (singular name)}}) => Promise<void>
}

interface FormErrors {
  {{#each (parseFields fields)}}
  {{name}}?: string
  {{/each}}
  general?: string
}

export function Edit{{pascalCase (singular name)}}Dialog({ {{singular name}}, open, onOpenChange, onSubmit }: Edit{{pascalCase (singular name)}}DialogProps) {
  const [formData, setFormData] = useState<IUpdate{{pascalCase (singular name)}}>({
    {{#each (parseFields fields)}}
    {{name}}: undefined,
    {{/each}}
  })
  const [errors, setErrors] = useState<FormErrors>({})
  const [isSubmitting, setIsSubmitting] = useState(false)

  useEffect(() => {
    if ({{singular name}}) {
      setFormData({
        {{#each (parseFields fields)}}
        {{name}}: {{singular ../name}}.{{name}},
        {{/each}}
      })
      setErrors({})
    }
  }, [{{singular name}}])

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault()
    if (!{{singular name}}?.id) return

    const { isValid, errors: validationErrors } = validateForm(update{{pascalCase (singular name)}}Schema, formData)
    if (!isValid) {
      setErrors(validationErrors)
      return
    }

    setIsSubmitting(true)
    try {
      await onSubmit({{singular name}}.id, formData)
      onOpenChange(false)
    } catch (error) {
      setErrors({
        general: error instanceof Error ? error.message : "Failed to update {{singular name}}"
      })
    } finally {
      setIsSubmitting(false)
    }
  }

  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent className="sm:max-w-[425px]">
        <DialogHeader>
          <DialogTitle>Edit {{startCase (singular name)}}</DialogTitle>
        </DialogHeader>

        {errors.general && (
          <Alert variant="destructive">
            <AlertCircle className="h-4 w-4" />
            <AlertDescription>{errors.general}</AlertDescription>
          </Alert>
        )}

        <form onSubmit={handleSubmit} className="space-y-4">
          {{#each (parseFields fields)}}
          <div className="space-y-2">
            <Label htmlFor="{{name}}">{{startCase name}}</Label>
            {{#if (eq type "string")}}
            <Input
              id="{{name}}"
              {{#if (eq name "email")}}type="email"{{/if}}
              value={formData.{{name}}}
              onChange={(e) => {
                setFormData({ ...formData, {{name}}: e.target.value })
                if (errors.{{name}}) setErrors({ ...errors, {{name}}: undefined })
              }}
              className={errors.{{name}} ? 'border-red-500' : ''}
              disabled={isSubmitting}
            />
            {{else if (eq type "number")}}
            <Input
              id="{{name}}"
              type="number"
              value={formData.{{name}}}
              onChange={(e) => {
                setFormData({ ...formData, {{name}}: Number(e.target.value) })
                if (errors.{{name}}) setErrors({ ...errors, {{name}}: undefined })
              }}
              className={errors.{{name}} ? 'border-red-500' : ''}
              disabled={isSubmitting}
            />
            {{else if (eq type "boolean")}}
            <Select
              value={String(formData.{{name}})}
              onValueChange={(value) => {
                setFormData({ ...formData, {{name}}: value === "true" })
                if (errors.{{name}}) setErrors({ ...errors, {{name}}: undefined })
              }}
              disabled={isSubmitting}
            >
              <SelectTrigger className={errors.{{name}} ? 'border-red-500' : ''}>
                <SelectValue placeholder="Select {{startCase name}}" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="true">Yes</SelectItem>
                <SelectItem value="false">No</SelectItem>
              </SelectContent>
            </Select>
            {{/if}}
            {errors.{{name}} && <p className="text-sm text-red-500">{errors.{{name}}}</p>}
          </div>
          {{/each}}

          <Button type="submit" className="w-full" disabled={isSubmitting}>
            {isSubmitting ? "Updating..." : "Update {{singular name}}"}
          </Button>
        </form>
      </DialogContent>
    </Dialog>
  )
}